.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environments con datos sensibles (solo producción)
src/environments/environment.prod.ts

# Backend: configuración local con claves sensibles
Backend/src/main/resources/application-dev.properties
Backend/src/main/resources/application-prod.properties

# Logs
logs
*.log

# Package locks (optional, uncomment if needed)
# package-lock.json
# yarn.lock

# Backend: Maven build
Backend/target/
Backend/pom.xml.tag
Backend/pom.xml.releaseBackup
Backend/pom.xml.versionsBackup
Backend/pom.xml.next
Backend/release.properties
Backend/dependency-reduced-pom.xml
Backend/buildNumber.properties
Backend/.mvn/timing.properties
Backend/.mvn/wrapper/maven-wrapper.jar
!Backend/**/src/main/**/target/
!Backend/**/src/test/**/target/

# Backend: artefactos empaquetados
Backend/*.jar
Backend/*.war
Backend/*.nar
Backend/*.ear

# Backend: Spring Boot devtools / JVM crash logs
spring-boot-devtools.properties
hs_err_pid*
replay_pid*

